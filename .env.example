# ─── Server ───────────────────────────────────────────────
SERVER_PORT=8080

# ─── Database ─────────────────────────────────────────────
# Docker Compose 내부 통신용 (컨테이너명 postgres)
DB_URL=jdbc:postgresql://postgres:5432/osstech
DB_USERNAME=osstech
DB_PASSWORD=osstech_secret

# postgres 컨테이너 초기화 변수
POSTGRES_DB=osstech
POSTGRES_USER=osstech
POSTGRES_PASSWORD=osstech_secret

# ─── WebClient Timeouts ───────────────────────────────────
WEBCLIENT_CONNECT_TIMEOUT_MS=5000
WEBCLIENT_READ_TIMEOUT_MS=30000

# ─── GitHub API ───────────────────────────────────────────
# 비워 두면 인증 없이 호출합니다(한도 매우 낮음). 실제 값은 이 파일이 아니라 .env 에만 넣으세요.
GITHUB_TOKEN=ghp_xxxx
GITHUB_API_BASE_URL=https://api.github.com
# 도메인당 수집할 레포 수 (기본 30). 토큰 없이 시험할 때는 3 정도로 낮추세요.
CRAWL_REPOS_PER_DOMAIN=30

# ─── AI 월간 리포트 (OpenAI 기본) ─────────────────────────
# 월간 리포트를 작성할 LLM 제공자: openai(기본) | claude
LLM_PROVIDER=openai
# ChatGPT 구독(Plus 등)과는 별개의 과금입니다. platform.openai.com 에서 API 키를 발급하고 크레딧을 충전해야 합니다.
# 실제 값은 이 파일이 아니라 .env 에만 넣으세요.
OPENAI_API_KEY=sk-xxxx
# 가성비 기본값. 더 싸게: gpt-6-luna / gpt-5-nano, 더 좋게: gpt-6.1-terra / gpt-5.4-mini
OPENAI_MODEL=gpt-5-mini
OPENAI_API_BASE_URL=https://api.openai.com
# 추론(reasoning) 토큰도 출력 과금에 포함됩니다. 비용을 더 줄이려면 low 로 (모델마다 지원 값이 다름, 비우면 모델 기본값)
OPENAI_REASONING_EFFORT=
# 추론 토큰을 포함한 출력 상한 (과금은 실제 생성한 만큼만)
OPENAI_MAX_OUTPUT_TOKENS=16000

# ── (선택) LLM_PROVIDER=claude 일 때만 사용 ──
CLAUDE_API_KEY=sk-ant-xxxx
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_API_BASE_URL=https://api.anthropic.com

# ─── Frontend ─────────────────────────────────────────────
# 브라우저에서 직접 호출하는 외부 URL
NEXT_PUBLIC_API_URL=http://localhost:8089
# Docker 컨테이너 내부 통신용 (next.config.ts rewrite 대상)
INTERNAL_API_URL=http://backend:8080
# 검색 노출용 canonical/hreflang 에 쓰이는 공개 주소 (배포 시 실제 도메인으로)
SITE_URL=http://localhost:3033
