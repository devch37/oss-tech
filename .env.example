# ─── Server ───────────────────────────────────────────────
SERVER_PORT=8080

# ─── Database ─────────────────────────────────────────────
# Docker Compose 내부 통신용 (컨테이너명 postgres)
DB_URL=jdbc:postgresql://postgres:5432/osstech
DB_USERNAME=osstech
DB_PASSWORD=osstech_secret

# postgres 컨테이너 초기화 변수
POSTGRES_DB=osstech
POSTGRES_USER=osstech
POSTGRES_PASSWORD=osstech_secret

# ─── WebClient Timeouts ───────────────────────────────────
WEBCLIENT_CONNECT_TIMEOUT_MS=5000
WEBCLIENT_READ_TIMEOUT_MS=30000

# ─── GitHub API ───────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxx
GITHUB_API_BASE_URL=https://api.github.com

# ─── Claude API ───────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-xxxx
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_API_BASE_URL=https://api.anthropic.com

# ─── Frontend ─────────────────────────────────────────────
# 브라우저에서 직접 호출하는 외부 URL
NEXT_PUBLIC_API_URL=http://localhost:8080
# Docker 컨테이너 내부 통신용 (next.config.ts rewrite 대상)
INTERNAL_API_URL=http://backend:8080
